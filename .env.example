NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://marketsentry:marketsentry@postgres:5432/marketsentry
REDIS_URL=redis://redis:6379

# Market data
MARKET_DATA_PROVIDER=twelve-data
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
MASSIVE_API_KEY=

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Notifications
NOTIFICATION_PROVIDER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# App defaults - all can later be overridden from persisted settings
DEFAULT_MARKETS=stocks,etfs,forex,commodities,indices,options
DEFAULT_TRADING_STYLES=intraday,swing
DEFAULT_SESSIONS=regular
DEFAULT_RISK_PROFILE=balanced
DEFAULT_CAPITAL=10000
ALERT_MIN_CONFIDENCE=0.80
ALERT_REQUIRE_URGENT=true
